# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Agent Identity uses certificate-bound tokens; force compatible mTLS APIs.
GOOGLE_API_USE_MTLS_ENDPOINT=always
GOOGLE_API_USE_CLIENT_CERTIFICATE=true
PJE_OFFICIAL_SEARCH_DATA_STORE_ID=projects/your-gcp-project-id/locations/global/collections/default_collection/dataStores/your-data-store-id
# Somente em testes: troca o Agent Platform Search por catálogo determinístico.
INTEGRATION_TEST=FALSE
# Zero retenção é o padrão: sessões/artefatos ficam apenas em memória e a
# exportação de telemetria é desligada para conteúdo processual.
PJE_ZERO_RETENTION=1
# O baseline permanece único até a comparação de qualidade/custo ser aprovada.
PJE_MODEL_ROUTING_ENABLED=0
# Usados somente quando o roteamento acima estiver habilitado após avaliação:
# PJE_ORCHESTRATOR_MODEL=gemini-3.5-flash
# PJE_DOCUMENT_WORKER_MODEL=gemini-3.6-flash
# PJE_INVENTORY_MODEL=gemini-3.5-flash
# PJE_FINAL_REVIEWER_MODEL=gemini-3.5-flash
# Testes que chamam modelos e geram custo só rodam com opt-in explícito.
PJE_RUN_LIVE_AGENT_TESTS=0

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
