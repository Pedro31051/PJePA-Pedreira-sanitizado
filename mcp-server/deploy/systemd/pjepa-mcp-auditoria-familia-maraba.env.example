# Copie para /etc/pjepa-mcp/auditoria-familia-maraba.env somente após
# aprovar o playbook. Este exemplo aponta para a política vigente do piloto.
PJE_STORAGE_DIR=/var/lib/pjepa-mcp/storage
PJE_TASK_POLICY_PATH=/etc/pjepa-mcp/policies/familia_maraba_draft_1.json
PJE_AUDIT_ALLOWED_TASKS="Verificar providência a adotar|Verificar providências a adotar|Providências a adotar"

# Não defina PJE_AUDIT_MASTER_KEY aqui. Use a credencial systemd
# audit_master_key descrita em deploy/systemd/pjepa-mcp-audit-credential.conf.
