# Configuração do deploy no Cloud Run.
# Copie para config.env (ignorado pelo Git) e revise cada valor; os scripts
# usam este exemplo apenas quando config.env não existe.

PROJECT_ID="${PROJECT_ID:-$(gcloud config get-value project 2>/dev/null)}"
REGION="${REGION:-southamerica-east1}"

SERVICE="pjepa-mcp"
AR_REPO="pjepa"
IMAGE_NAME="pjepa-mcp"

# Egress com IP fixo: Direct VPC egress + Cloud NAT (sem connector serverless).
NETWORK="pjepa-egress"
SUBNET="pjepa-egress-sub"
SUBNET_RANGE="10.190.0.0/24"
ROUTER="pjepa-router"
NAT_GATEWAY="pjepa-nat"
NAT_IP_NAME="pjepa-nat-ip"

# Estado persistente montado via GCS FUSE em /var/lib/pjepa-mcp.
STATE_BUCKET="${STATE_BUCKET:-${PROJECT_ID}-pjepa-mcp-estado}"

# Prefixo dos quatro segredos no Secret Manager (cpf, senha, totp-seed,
# audit-master-key) — mesmo contrato do systemd LoadCredential.
SECRET_PREFIX="pjepa-mcp"

RUNTIME_SA_ID="pjepa-mcp-runtime"
INVOKER_SA_ID="pjepa-mcp-invoker"

# Dimensionamento para ~12 usuários simultâneos: até 6 instâncias com 2
# requisições cada; um Chromium por requisição cabe em 2 vCPU / 4 GiB.
CPU="2"
MEMORY="4Gi"
CONCURRENCY="2"
MIN_INSTANCES="0"
MAX_INSTANCES="6"
TIMEOUT="600"
